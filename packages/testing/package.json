  },
  "dependencies": {
    "@zahln/domain": "*",
    "@zahln/application": "*",
    "@zahln/api-client": "*"
  },
  "devDependencies": {
    "@zahln/eslint-config": "*",
    "@zahln/tsconfig": "*"
  }
}
