{
  "name": "@zahln/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Zahln API client: resilient HTTP transport (timeouts, safe retries, idempotency keys, re-login) and adapters for the application ports, validated against Zahln's OpenAPI spec.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/generated/schema.ts",
    "refresh-spec": "curl -fsS https://dev.zahln.de/openapi.json -o ../../docs/api/openapi.json && npm run generate"
  },
  "dependencies": {
    "@zahln/application": "*",
    "@zahln/domain": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@zahln/eslint-config": "*",
    "@zahln/tsconfig": "*",
    "openapi-typescript": "^7.13.0"
  }
}
