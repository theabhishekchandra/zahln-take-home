{
  "name": "zahln",
  "private": true,
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "student": "npm run start -w @zahln/student",
    "till": "npm run start -w @zahln/till",
    "dashboard": "npm run dev -w @zahln/dashboard"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
